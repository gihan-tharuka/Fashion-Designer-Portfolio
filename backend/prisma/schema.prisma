generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

enum LookImageType {
  HERO
  LINEUP
  DEVELOPMENT
  MODEL
  FINAL_VIEWS
  PROCESS
  DETAIL
}

enum PriceStatus {
  CONFIRMED
  TO_BE_FINALISED
  PRICE_ON_REQUEST
}

enum SkillType {
  SKILL
  CREATIVE_INTEREST
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
}

enum EnquiryInterestType {
  INTERNSHIP
  COLLABORATION
  COMMISSION
  STYLING
  PORTFOLIO_VIEWING
  PRICING
  OTHER
}

enum UserRole {
  ADMIN
}

model Collection {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  season        String
  subtitle      String?
  description   String
  heroImageUrl  String?
  lineupImageUrl String?
  brandImageUrl String?
  status        CollectionStatus @default(PUBLISHED)
  displayOrder  Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  looks         Look[]
  processItems  ProcessItem[]
}

model Look {
  id                       String         @id @default(cuid())
  collectionId             String
  number                   String
  slug                     String         @unique
  name                     String
  subtitle                 String?
  description              String
  concept                  String?
  designDevelopment        String?
  problemsAndImprovements  String?
  outcomeAndReflection     String?
  displayOrder             Int
  isFeatured               Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  collection               Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  images                   LookImage[]
  materials                LookMaterial[]
  tags                     LookTag[]
  garments                 Garment[]

  @@unique([collectionId, number])
  @@index([collectionId, displayOrder])
}

model LookImage {
  id          String        @id @default(cuid())
  lookId       String
  type        LookImageType
  url         String
  alt         String
  caption     String?
  displayOrder Int         @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  look        Look          @relation(fields: [lookId], references: [id], onDelete: Cascade)

  @@index([lookId, type, displayOrder])
}

model LookMaterial {
  id          String   @id @default(cuid())
  lookId       String
  label       String
  value       String
  displayOrder Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  look        Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)

  @@index([lookId, displayOrder])
}

model LookTag {
  id          String   @id @default(cuid())
  lookId       String
  label       String
  displayOrder Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  look        Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)

  @@index([lookId, displayOrder])
}

model Garment {
  id          String          @id @default(cuid())
  lookId       String
  name        String
  fabric      String
  displayOrder Int           @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  look        Look            @relation(fields: [lookId], references: [id], onDelete: Cascade)
  costing     GarmentCosting?

  @@index([lookId, displayOrder])
}

model GarmentCosting {
  id                          String      @id @default(cuid())
  garmentId                   String      @unique
  currency                    String      @default("LKR")
  fabricUsage                 String
  fabricPricePerYard          Decimal?    @db.Decimal(10, 2)
  fabricPricePerYardStatus    PriceStatus @default(CONFIRMED)
  fabricCost                  Decimal?    @db.Decimal(10, 2)
  fabricCostStatus            PriceStatus @default(CONFIRMED)
  batikOrDyeCost              Decimal?    @db.Decimal(10, 2)
  sewingCost                  Decimal?    @db.Decimal(10, 2)
  trimsCost                   Decimal?    @db.Decimal(10, 2)
  finishingCost               Decimal?    @db.Decimal(10, 2)
  totalProductionCost         Decimal?    @db.Decimal(10, 2)
  totalProductionCostStatus   PriceStatus @default(CONFIRMED)
  profitMarginPercent         Decimal?    @db.Decimal(5, 2)
  profitMarginStatus          PriceStatus @default(CONFIRMED)
  finalSellingPrice           Decimal?    @db.Decimal(10, 2)
  finalSellingPriceStatus     PriceStatus @default(CONFIRMED)
  notes                       String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  garment                     Garment     @relation(fields: [garmentId], references: [id], onDelete: Cascade)
}

model ProcessItem {
  id          String   @id @default(cuid())
  collectionId String
  number      String?
  title       String
  description String
  imageUrl    String?
  imageAlt    String?
  category    String?
  displayOrder Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, displayOrder])
}

model DesignerProfile {
  id             String   @id @default(cuid())
  name           String
  title          String
  bio            String
  portraitUrl    String?
  quote          String?
  email          String
  phone          String?
  linkedinUrl    String?
  location       String?
  portfolioPdfUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skills         Skill[]
}

model Skill {
  id               String    @id @default(cuid())
  designerProfileId String
  label            String
  type             SkillType
  displayOrder     Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  designerProfile  DesignerProfile @relation(fields: [designerProfileId], references: [id], onDelete: Cascade)

  @@index([designerProfileId, type, displayOrder])
}

model SiteSetting {
  id             String   @id @default(cuid())
  siteTitle      String
  siteDescription String
  logoUrl        String?
  faviconUrl     String?
  contactEmail   String
  contactPhone   String?
  linkedinUrl    String?
  portfolioPdfUrl String?
  location       String?
  copyrightText  String?
  seasonLabel    String?
  collectionName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Enquiry {
  id           String              @id @default(cuid())
  name         String
  email        String
  phone        String?
  subject      String?
  message      String
  interestType EnquiryInterestType @default(OTHER)
  status       EnquiryStatus       @default(NEW)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
